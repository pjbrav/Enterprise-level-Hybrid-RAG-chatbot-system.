# Database path (default: hybrid_rag_v22.db)
SQLITE_DATABASE_PATH=hybrid_rag_v22.db

# Smart router thresholds (defaults shown — override per deployment)
ROUTER_STANDARD_CONFIDENCE_HIGH=0.99
ROUTER_STANDARD_CONFIDENCE_LOW=0.40
ROUTER_HYBRID_SCORE_THRESHOLD=0.50
ROUTER_LAST_RESORT_THRESHOLD=0.55
MIN_THRESHOLD=0.20
CROSS_DOMAIN_THRESHOLD_RELIEF=0.12

# FTS5 search parameters
MAX_FTS_QUERY_TERMS=6
MAX_FTS_TERM_FANOUT=20000

# OpenAI API key (required for answer generation)
OPENAI_API_KEY=sk-your-key-here
